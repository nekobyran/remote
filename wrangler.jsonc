{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nkbr-release",
  "main": "worker.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "nkbr.cc/*",
      "zone_name": "nkbr.cc"
    },
    { "pattern": "codexmax.nkbr.cc/", "zone_name": "nkbr.cc" },
    { "pattern": "codexmax.nkbr.cc/index.html", "zone_name": "nkbr.cc" },
    { "pattern": "codexmax.nkbr.cc/release", "zone_name": "nkbr.cc" },
    { "pattern": "codexmax.nkbr.cc/release/", "zone_name": "nkbr.cc" },
    { "pattern": "codexmax.nkbr.cc/_nkbr/*", "zone_name": "nkbr.cc" },
    { "pattern": "androidsimulator.nkbr.cc/", "zone_name": "nkbr.cc" },
    { "pattern": "androidsimulator.nkbr.cc/index.html", "zone_name": "nkbr.cc" },
    { "pattern": "androidsimulator.nkbr.cc/release", "zone_name": "nkbr.cc" },
    { "pattern": "androidsimulator.nkbr.cc/release/", "zone_name": "nkbr.cc" },
    { "pattern": "androidsimulator.nkbr.cc/_nkbr/*", "zone_name": "nkbr.cc" },
    { "pattern": "skillcreator.nkbr.cc/", "zone_name": "nkbr.cc" },
    { "pattern": "skillcreator.nkbr.cc/index.html", "zone_name": "nkbr.cc" },
    { "pattern": "skillcreator.nkbr.cc/release", "zone_name": "nkbr.cc" },
    { "pattern": "skillcreator.nkbr.cc/release/", "zone_name": "nkbr.cc" },
    { "pattern": "skillcreator.nkbr.cc/_nkbr/*", "zone_name": "nkbr.cc" },
    { "pattern": "gamelauncher.nkbr.cc/", "zone_name": "nkbr.cc" },
    { "pattern": "gamelauncher.nkbr.cc/index.html", "zone_name": "nkbr.cc" },
    { "pattern": "gamelauncher.nkbr.cc/release", "zone_name": "nkbr.cc" },
    { "pattern": "gamelauncher.nkbr.cc/release/", "zone_name": "nkbr.cc" },
    { "pattern": "gamelauncher.nkbr.cc/_nkbr/*", "zone_name": "nkbr.cc" },
    { "pattern": "lanzouplus.nkbr.cc/", "zone_name": "nkbr.cc" },
    { "pattern": "lanzouplus.nkbr.cc/index.html", "zone_name": "nkbr.cc" },
    { "pattern": "lanzouplus.nkbr.cc/release", "zone_name": "nkbr.cc" },
    { "pattern": "lanzouplus.nkbr.cc/release/", "zone_name": "nkbr.cc" },
    { "pattern": "lanzouplus.nkbr.cc/_nkbr/*", "zone_name": "nkbr.cc" },
    { "pattern": "flclashplus.nkbr.cc/", "zone_name": "nkbr.cc" },
    { "pattern": "flclashplus.nkbr.cc/index.html", "zone_name": "nkbr.cc" },
    { "pattern": "flclashplus.nkbr.cc/release", "zone_name": "nkbr.cc" },
    { "pattern": "flclashplus.nkbr.cc/release/", "zone_name": "nkbr.cc" },
    { "pattern": "flclashplus.nkbr.cc/_nkbr/*", "zone_name": "nkbr.cc" },
    { "pattern": "kacha.nkbr.cc/", "zone_name": "nkbr.cc" },
    { "pattern": "kacha.nkbr.cc/index.html", "zone_name": "nkbr.cc" },
    { "pattern": "kacha.nkbr.cc/release", "zone_name": "nkbr.cc" },
    { "pattern": "kacha.nkbr.cc/release/", "zone_name": "nkbr.cc" },
    { "pattern": "kacha.nkbr.cc/_nkbr/*", "zone_name": "nkbr.cc" }
  ],
  "assets": {
    "directory": "./.stage",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
