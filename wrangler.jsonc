{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nkbr-release",
  "main": "worker.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "nkbr.cc/*",
      "zone_name": "nkbr.cc"
    }
  ],
  "assets": {
    "directory": "./.stage",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
